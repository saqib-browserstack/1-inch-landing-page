#!/usr/bin/env bash
GIT_ROOT=$(git rev-parse --show-toplevel)

if [ -n "$SKIP_A11Y_CHECKS" ]; then
  echo "Skipping accessibility checks."
  exit 0
fi

echo "Running accessibility checks on staged changes..."

if [ -n "$NON_STRICT_A11Y_CHECKS" ]; then
  "$GIT_ROOT/browserstack-cli" accessibility --include "$GIT_ROOT/src/**/*.jsx"
  exit 0
fi

"$GIT_ROOT/browserstack-cli" accessibility --include "$GIT_ROOT/src/**/*.jsx" --scope=diff
exit $?